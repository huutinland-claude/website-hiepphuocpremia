# =====================================================================
#  HIỆP PHƯỚC PREMIA – Landing page configuration
#  Copy to .env (local) or add to Vercel → Project → Settings → Environment Variables.
#  KHÔNG commit file .env thật. Không đưa các khóa bí mật vào frontend.
# =====================================================================

# --- Site -------------------------------------------------------------
# Domain chính thức (dùng cho canonical, Open Graph, sitemap). Bắt buộc khi deploy.
SITE_URL=http://localhost:3000
PORT=3000

# --- Database ---------------------------------------------------------
# Để trống  -> dùng SQLite tại data/leads.db (chỉ phù hợp chạy local / VPS).
# Vercel    -> BẮT BUỘC dùng Postgres (Neon / Supabase / Vercel Postgres):
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=
SQLITE_PATH=data/leads.db

# --- Admin / bảo mật --------------------------------------------------
# Chuỗi ngẫu nhiên >= 32 ký tự. Tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Muối băm IP (ẩn danh hóa IP khi chống spam). Chuỗi ngẫu nhiên bất kỳ.
IP_HASH_SALT=
# Tài khoản admin đầu tiên (chỉ được tạo khi database chưa có user nào). Xóa sau khi tạo xong.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Thông tin liên hệ (có thể sửa trong Dashboard → Cấu hình) -------
# Để trống thì nút Hotline / Zalo sẽ tự ẩn. Không điền số giả.
HOTLINE=
ZALO_PHONE=
# Link Zalo OA (nếu có), ví dụ https://zalo.me/123456789. Ưu tiên hơn ZALO_PHONE.
ZALO_URL=

# --- Meta Ads ---------------------------------------------------------
META_PIXEL_ID=
# Conversions API (server-side). Lấy trong Events Manager → Settings → Conversions API.
META_CAPI_ACCESS_TOKEN=
# Mã test (Events Manager → Test events). Xóa khi chạy thật.
META_TEST_EVENT_CODE=
META_API_VERSION=v21.0

# --- Google -----------------------------------------------------------
# Nếu dùng GTM: điền GTM_ID và cấu hình GA4 / Google Ads bên trong GTM (khuyến nghị).
GTM_ID=
# Nếu KHÔNG dùng GTM: điền GA4 + Google Ads, trang sẽ tải gtag.js trực tiếp.
GA4_MEASUREMENT_ID=
# GA4 Measurement Protocol (gửi sự kiện qualify_lead từ server khi lead chuyển "Qualified")
GA4_API_SECRET=
# Google Ads conversion: AW-XXXXXXXXX và label của conversion action "Lead"
GOOGLE_ADS_ID=
GOOGLE_ADS_LEAD_LABEL=
# Tên conversion action dùng cho file Offline Conversion Import (Qualified lead)
GOOGLE_ADS_OFFLINE_CONVERSION_NAME=Qualified Lead

# --- Chống spam (tùy chọn) --------------------------------------------
# Cloudflare Turnstile. Để trống = chỉ dùng honeypot + giới hạn tần suất + kiểm tra thời gian điền form.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Thông báo lead mới (tùy chọn, cấu hình kênh nào dùng kênh đó) ---
# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email qua Resend (https://resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=
# Webhook chung cho CRM / Zalo OA / n8n / Make. Payload JSON, ký HMAC-SHA256 ở header X-Signature.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
